# ─── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=80

# ─── Base de datos · MySQL COMPARTIDO (core en /opt/shared, contenedor mysql_db) ─
# No se levanta MySQL propio: se consume el del core en net-shared. DB en MAYÚSCULAS.
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=root
# = DB_MYSQL_ROOT_PASSWORD del core (ver /opt/shared/.env)
DB_ROOT_PASSWORD=secret
DB_NAME=MUNDIAL
DB_DIALECT=mysql

# ─── Cache / snapshots con TTL · Redis COMPARTIDO (redis en net-shared) ─────
REDIS_URL=redis://redis:6379
# TTL del snapshot de datos por selección (segundos). Default 6h.
TEAM_SNAPSHOT_TTL_SECONDS=21600

# ─── Secreto para disparar jobs/cron manualmente (admin) ───────────────────
CRON_SECRET=cambia-esta-clave-cron

# ─── Proveedores de datos de fútbol ────────────────────────────────────────
# Proveedor principal para fixtures/resultados/posiciones/alineaciones/h2h.
# Opciones: api-football | football-data
DATA_PROVIDER=football-data

# API-Football (API-SPORTS) — https://www.api-football.com/
APIFOOTBALL_KEY=
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
# ID de la liga "World Cup" y temporada 2026 en API-Football.
APIFOOTBALL_LEAGUE_ID=1
APIFOOTBALL_SEASON=2026

# football-data.org — https://www.football-data.org/
FOOTBALLDATA_KEY=
FOOTBALLDATA_BASE_URL=https://api.football-data.org/v4
# Código de la competición Mundial en football-data.org (World Cup = WC).
FOOTBALLDATA_COMPETITION=WC

# Histórico para sembrar la forma (CSV de football-data.co.uk u otro dataset).
# URL o ruta local de un CSV de resultados internacionales históricos.
HISTORY_CSV_URL=

# Ranking FIFA (fuente que publique los puntos por selección).
FIFA_RANKING_URL=

# ─── Motor de simulación (parámetros calibrables, ver sección 7/13.4) ──────
# Cuánto pesa un punto FIFA en la diferencia de goles esperada.
SIM_K=0.0016
# Cuánto pesa el ranking FIFA frente a la forma reciente (0..1).
SIM_RANKING_WEIGHT=0.6
# Goles totales esperados de referencia en un partido parejo.
SIM_TOTAL_GOALS=2.6
# Intensidad de la corrección Dixon-Coles para marcadores bajos.
SIM_RHO=-0.06
# Vida media (en días) del decaimiento temporal de la forma.
SIM_FORM_HALFLIFE_DAYS=240
# Ventaja de anfitrión (EE.UU., Canadá, México), en goles esperados.
SIM_HOME_ADVANTAGE=0.35
# Cantidad de partidos recientes para la forma.
SIM_FORM_MATCHES=12
# Cantidad de simulaciones de Monte Carlo para la proyección del torneo.
SIM_MONTE_CARLO_RUNS=10000

# ─── Capa en vivo (sondeo acotado durante la ventana del partido) ──────────
LIVE_ENABLED=true
# Cada cuántos segundos sondear el feed durante un partido en juego.
LIVE_POLL_SECONDS=45
# Minutos antes del inicio para abrir la ventana de sondeo en vivo.
LIVE_WINDOW_BEFORE_MIN=10
# Minutos después del final estimado para cerrar la ventana.
LIVE_WINDOW_AFTER_MIN=30

# ─── Jobs / cron ───────────────────────────────────────────────────────────
ENABLE_JOBS=true
