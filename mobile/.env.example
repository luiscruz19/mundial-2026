# Variables para builds/ejecución LOCAL (React Native CLI + react-native-config).
# Copiá este archivo a .env y elegí la URL del backend según el caso.
# El cliente HTTP lee Config.API_URL (ver src/config.ts); si no hay .env usa
# como fallback https://mundial.sda.ovh.

# APK/emulador contra el SERVER (HTTPS) — funciona desde cualquier red. Recomendado.
API_URL=https://mundial.sda.ovh

# Contra el backend LOCAL en tu PC:
#  - Emulador Android: el host de tu PC se ve como 10.0.2.2 (NO localhost)
#    API_URL=http://10.0.2.2:4000
#  - Celular físico en la misma WiFi: usá la IP LAN de tu PC
#    API_URL=http://192.168.100.8:4000
