# Variables para builds/ejecución LOCAL (Expo carga este archivo como .env automáticamente).
# Los perfiles de eas.json NO aplican a builds locales (expo run:android / prebuild+gradle),
# por eso acá se define el backend. Copiá este archivo a .env y elegí la URL según el caso.

# APK/emulador contra el SERVER (HTTPS) — funciona desde cualquier red. Recomendado.
EXPO_PUBLIC_API_URL=https://mundial.sda.ovh

# Contra el backend LOCAL en tu PC:
#  - Emulador Android: el host se ve como 10.0.2.2 (NO localhost)
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#  - Celular físico en la misma WiFi: usá la IP LAN de tu PC
#    EXPO_PUBLIC_API_URL=http://192.168.100.8:4000
