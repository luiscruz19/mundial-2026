# ════════════════════════════════════════════════════════════════════════════
#  MUNDIAL 2026 · .env del SERVER (test). Copiar a /opt/test/mundial/.env y
#  completar con las credenciales de /opt/shared/.env + el token del proveedor.
#  NO versionar el .env real (solo este example).
# ════════════════════════════════════════════════════════════════════════════
TAG=TEST
NODE_ENV=production
API_PORT=80

# ─── Base de datos · MySQL COMPARTIDO (/opt/shared, contenedor mysql_db) ─────
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=root
# = DB_MYSQL_ROOT_PASSWORD de /opt/shared/.env
DB_ROOT_PASSWORD=
DB_NAME=MUNDIAL
DB_DIALECT=mysql

# ─── Cache / snapshots · Redis COMPARTIDO ────────────────────────────────────
REDIS_URL=redis://redis:6379
TEAM_SNAPSHOT_TTL_SECONDS=21600

# ─── Secreto para los endpoints admin (/admin/*) ─────────────────────────────
CRON_SECRET=

# ─── Proveedor de datos de fútbol ────────────────────────────────────────────
DATA_PROVIDER=football-data
FOOTBALLDATA_KEY=
FOOTBALLDATA_BASE_URL=https://api.football-data.org/v4
FOOTBALLDATA_COMPETITION=WC

# (Opcional) fuentes extra
HISTORY_CSV_URL=
FIFA_RANKING_URL=

# ─── Motor de simulación (calibrables) ───────────────────────────────────────
SIM_K=0.0016
SIM_RANKING_WEIGHT=0.6
SIM_TOTAL_GOALS=2.6
SIM_RHO=-0.06
SIM_FORM_HALFLIFE_DAYS=240
SIM_HOME_ADVANTAGE=0.35
SIM_FORM_MATCHES=12
SIM_MONTE_CARLO_RUNS=10000

# ─── Capa en vivo + jobs ─────────────────────────────────────────────────────
LIVE_ENABLED=true
LIVE_POLL_SECONDS=45
ENABLE_JOBS=true
